# Copy to .env for local development. On the resolver host these live in
# /etc/hydra-dns/hydra.env instead -- deploy/README.md walks through filling them in.

# -- required ---------------------------------------------------------------------------------

# One object per AdGuard DNS account. Must be valid JSON on a single line.
#   label     what the dashboard calls it
#   username  the account email
#   password  the account password (2FA accounts cannot use the password grant)
#   device_id optional, pins a specific AdGuard device instead of discovering one
#   doh_url   optional, skips discovery entirely and forwards straight to this URL
HYDRA_ADGUARD_ACCOUNTS=[{"label":"main","username":"you@example.com","password":"changeme"}]

# The password you type to read the dashboard.
HYDRA_DASHBOARD_PASSWORD=changeme

# Device URLs are HMAC-derived from this, so it must be stable: changing it changes every
# device URL at once. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HYDRA_RESOLVER_SECRET=generate-a-long-random-string

# Signs dashboard session cookies. Rotating it signs you out and nothing else.
HYDRA_SESSION_SECRET=another-long-random-string

# -- resolver ---------------------------------------------------------------------------------

# Comma-separated device ids, optionally "id:Display Name".
HYDRA_DEVICES=laptop:Laptop,phone:Phone

# balanced | round_robin | quota_weighted | least_used
# balanced is cell balancing: the least-used account is served first, so every account
# reaches its monthly limit on the same day instead of one dying weeks before the rest.
HYDRA_STRATEGY=balanced

# The share of traffic the most-used account keeps while the others catch up, as a fraction
# of its own limit. 0 freezes it completely until the pack is level; 0.01 keeps it warm for
# roughly 1 query in 170 at no measurable cost. Above about 0.02 it starts stranding quota.
HYDRA_BALANCE_FLOOR=0.01

# -- DNS-over-TLS, for Android's native Private DNS -------------------------------------------
# Needs a host that can bind 853 and a wildcard certificate for *.<base domain>. Leave disabled
# anywhere that cannot (most PaaS hosts), but keep the base domain set so the dashboard can still show
# each device's DoT hostname.
HYDRA_DOT_ENABLED=false
HYDRA_DOT_BASE_DOMAIN=dot.example.com
# HYDRA_DOT_HOST=0.0.0.0
# HYDRA_DOT_PORT=853
# HYDRA_DOT_CERT=/etc/letsencrypt/live/hydra/fullchain.pem
# HYDRA_DOT_KEY=/etc/letsencrypt/live/hydra/privkey.pem
#
# How often both listeners check whether certbot has replaced the certificate underneath them.
# A renewal is loaded into the live TLS context, so connections already up keep the certificate
# they negotiated with and every handshake after it gets the new one. Nothing is dropped and no
# port is rebound, which is why renewal is no longer a restart and no longer an outage.
# "systemctl reload hydra-dns" sends SIGHUP and forces the check immediately.
# HYDRA_DOT_CERT_POLL=300

# -- DNS-over-QUIC, the same identity over UDP ------------------------------------------------
# RFC 9250. Same wildcard certificate, same base domain, same token-in-SNI as DoT -- only the
# transport differs. QUIC gives every query its own stream, so one lost packet no longer stalls
# every lookup queued behind it, which is the failure DoT has on a phone moving between cells.
# Listens on 853/udp, which is a separate firewall rule from 853/tcp in both the cloud
# firewall and the host firewall.
HYDRA_DOQ_ENABLED=false
# HYDRA_DOQ_HOST=0.0.0.0
# HYDRA_DOQ_PORT=853
# HYDRA_DOQ_IDLE_TIMEOUT=30

# -- The HTTPS listener -----------------------------------------------------------------------
# The API and DoH. Falls back to the DoT certificate, and is reloaded in place the same way,
# which is why the service starts through "python -m hydra_dns.serve" rather than being handed
# to uvicorn on the command line -- owning the config is what makes its TLS context reachable.
# HYDRA_HTTP_HOST=0.0.0.0
# HYDRA_HTTP_PORT=8080
# HYDRA_HTTP_CERT=/etc/letsencrypt/live/hydra/fullchain.pem
# HYDRA_HTTP_KEY=/etc/letsencrypt/live/hydra/privkey.pem

# Answer without a device token. Leave off unless you know why you want it: an open DoH
# resolver on the public internet gets found, and the cost lands on your query allowance.
HYDRA_ALLOW_ANONYMOUS=false

# HYDRA_UPSTREAM_TIMEOUT_MS=4000
# HYDRA_CACHE_MAX_ENTRIES=20000
# HYDRA_CACHE_MIN_TTL=30
# HYDRA_CACHE_MAX_TTL=86400
# HYDRA_RATE_LIMIT_QPS=80

# -- browser-facing ---------------------------------------------------------------------------

# Where this API is reachable. Used to build the URLs shown on the dashboard and embedded in
# generated Apple profiles, so it has to match reality.
HYDRA_PUBLIC_API_BASE=http://localhost:8080

# Origins allowed to call the API with credentials. Comma separated, never a wildcard.
HYDRA_CORS_ORIGINS=http://localhost:3200

# Cookie domain. Leave empty for localhost; set to .example.com in production so the
# dashboard and the API share the cookie.
HYDRA_COOKIE_DOMAIN=
#
# How long a dashboard session lasts, in seconds. Default is 14 days.
# HYDRA_SESSION_TTL=1209600

# Domains kept out of both query logs on the dashboard. Comma separated, matched on the
# domain itself and anything under it. The default hides the HYDRA_PUBLIC_API_BASE host, as the
# dashboard polls its API every five seconds and those rows bury everything else. Only the
# log is filtered -- the queries still count towards traffic, quota and the charts.
# HYDRA_LOG_HIDDEN_DOMAINS=example.com

# Names answered here instead of upstream, comma separated. Hydra is the resolver, so a
# hostname on your own LAN never needs to leave the house or spend allowance. This is the
# seed and the fallback only: once device storage is configured these are managed from the
# dashboard, the same way devices and accounts are.
# HYDRA_REWRITES=nas.home=192.168.1.5,printer.home=192.168.1.9
# HYDRA_REWRITE_TTL=300

# Suffixes answered here rather than upstream, comma separated. mDNS names, the private
# reverse zones and the TLDs ICANN will never delegate cannot be answered by anything above
# us, so asking costs a query to be told NXDOMAIN. Set it to nothing to disable the whole
# check. `test` is left out of the default on purpose -- it is what local development tooling
# usually points at a machine on your desk. A rewrite is still checked first.
# HYDRA_LOCAL_ZONES=local,localhost,home.arpa,internal,intranet,lan,home,corp,invalid,onion,10.in-addr.arpa,168.192.in-addr.arpa
# HYDRA_LOCAL_ZONE_TTL=3600

# Answer RFC 9462 discovery. A client already using Hydra can ask, with a SVCB query for
# _dns.resolver.arpa, where its encrypted endpoints are; the answer is that device's own DoH URL
# and DoT hostname. DoT and DoQ appear in it only when their listeners actually came up, never
# merely because they are switched on.
# HYDRA_DDR=true

# Refuse an upstream answer that points a public name at a private, loopback, CGNAT or
# link-local address. That is how a web page reaches the router and the NAS; the device gets its
# block answer instead. HYDRA_REBIND_ALLOW lists suffixes that may, matched against the name
# asked for; plex.direct is the one service that needs it.
# HYDRA_REBIND_GUARD=true
# HYDRA_REBIND_ALLOW=plex.direct


# Renew hot answers just before they expire, so a domain the household asks for all day is
# never missing from the cache. Costs the one upstream query the expiry was going to cost
# anyway; only answers read HYDRA_PREFETCH_MIN_HITS times since they were stored qualify.
# HYDRA_PREFETCH=true
# HYDRA_PREFETCH_EVERY=30
# HYDRA_PREFETCH_WINDOW=90
# HYDRA_PREFETCH_MIN_HITS=4
# HYDRA_PREFETCH_MAX=20

# When /api/status starts saying "attention": a certificate this close to expiry, or an
# account that has failed to renew its token this many times in a row while still signed in.
# HYDRA_CERT_WARN_DAYS=14
# HYDRA_AUTH_WARN_FAILURES=3

# -- refresh cadences -------------------------------------------------------------------------

# HYDRA_LIMITS_REFRESH=300
# HYDRA_STATS_CACHE=60
# HYDRA_LOG_LEVEL=INFO
# HYDRA_DOCS=1

# -- device registry (optional) ---------------------------------------------------------------
# Without these, devices come from HYDRA_DEVICES only and cannot be edited from the dashboard.
# Apply supabase/001_device_registry.sql first, then insert the secret into hydra.config.
HYDRA_STORE_URL=
HYDRA_STORE_KEY=
HYDRA_STORE_SECRET=
# HYDRA_STORE_REFRESH=300
#
# Permission to write the initial device rows when the registry is empty. Off by default and
# worth leaving off: the registry is shared, so a laptop that finds the table empty would seed
# it from the HYDRA_DEVICES above and overwrite the real device names. Set it true on one host,
# once, for a first-time setup.
# HYDRA_STORE_SEED=false
#
# For local development, leave HYDRA_STORE_* empty entirely. Devices then come from the seed
# list and nothing local can touch the shared registry.
#
# Mirror of the last successful registry read, used only when Postgres cannot be reached at
# startup. Empty disables it, which is right for a dev machine. On a server it should point
# somewhere persistent -- see deploy/.
# HYDRA_DEVICE_CACHE=/var/lib/hydra-dns/devices.json
#
# Persist the resolver's own counters (totals, per-device, timeline, top domains, query log)
# so they survive a restart. Uses the same HYDRA_STORE_* credentials; needs
# supabase/002_metrics_persistence.sql applied.
# HYDRA_METRICS_PERSIST=false
# HYDRA_METRICS_FLUSH=60

# Where accounts added from the dashboard are stored. HYDRA_ADGUARD_ACCOUNTS above becomes the
# seed and the fallback once this is set: it fills this file on first run, and the file is
# authoritative afterwards. Leave it empty locally -- accounts then come from the env var and
# the dashboard shows them read-only. On a server it must be a path only the service user can
# read: it holds AdGuard passwords in plain text, and is written 0600.
# HYDRA_ACCOUNTS_FILE=/var/lib/hydra-dns/accounts.json
#
# Last-resort resolver, used only when every account is out of quota or benched. Keeps devices
# resolving -- unfiltered -- instead of answering SERVFAIL, and /api/health reports "degraded"
# so a keyword monitor alerts. Quad9 by default because it still blocks malware and phishing,
# so the degraded mode loses ad-blocking rather than all protection. Set it empty to fail hard
# instead.
# HYDRA_FALLBACK_DOH=https://dns.quad9.net/dns-query
#
# Name shown on the dashboard.
# HYDRA_SERVICE_NAME=Hydra DNS
#
# How long a blocked answer is held before AdGuard is asked again. Much longer than
# HYDRA_CACHE_MIN_TTL on purpose: blocked domains are the most-retried traffic there is and a
# 0.0.0.0 answer cannot go stale. The TTL handed to the device stays at HYDRA_CACHE_MIN_TTL, so
# it keeps asking -- that costs nothing and is what lets unblocking take effect quickly, since
# Hydra can clear its own cache but never the phone's. Set this to HYDRA_CACHE_MIN_TTL to turn
# the distinction off.
# HYDRA_CACHE_BLOCKED_MIN_TTL=1800
#
# Where the answer cache is written so it survives a restart. Read back at startup, written on a
# timer and on shutdown. A restart used to throw the cache away entirely, and every entry in it
# is a query that then has to be bought back from an account's monthly allowance. Expiry is
# stored as time remaining rather than as a deadline, so entries keep ageing while the process is
# down and anything that expired in the meantime is dropped on the way in. Unset means cold.
# HYDRA_CACHE_FILE=/var/lib/hydra-dns/cache.json
# HYDRA_CACHE_SAVE_EVERY=300
# HYDRA_CACHE_SAVE_MAX=10000
#
# Top domains resolved at startup when the cache really did come up cold -- a new host, or a
# snapshot too old to be worth anything. Skipped entirely when the snapshot restored, so a good
# one is never paid for twice. 0 disables it.
# HYDRA_CACHE_WARM=50
#
# How long past expiry an answer is kept so it can still be served when every account is spent
# or unreachable (RFC 8767). The degraded mode's real cost is that devices resolve unfiltered;
# a day-old answer is a better thing to hand them than an unfiltered one, and it costs no
# allowance at all. It is handed out with a HYDRA_CACHE_MIN_TTL lifetime so the device comes
# back promptly, and it is labelled "stale" in the log rather than passed off as fresh.
# 0 turns serving stale off.
# HYDRA_CACHE_STALE_WINDOW=86400
#
# A ceiling on upstream queries per device per rolling hour, so one device behind a valid token
# cannot drain the pooled allowance on its own. Only queries about to be bought from an account
# are counted: cache hits, device-rule blocks, rewrites and safe-search substitutions are free
# and are never refused. A device that runs out is served stale if anything is cached and
# SERVFAIL if not, so it falls through to its secondary rather than being silently blocked, and
# the breach becomes a reason on /api/status within the minute. Off by default -- read the
# per-device figures for a week first, then set it above the noisiest device's worst hour.
# HYDRA_DEVICE_HOURLY_BUDGET=0
#
# How little projected allowance is worth warning about. /api/status reports "attention"
# instead of "nominal" below this, so a keyword monitor tells you before the pool runs out
# rather than after.
# HYDRA_QUOTA_WARN_DAYS=5
#
# ---------------------------------------------------------------------------------------------
# Observability, audit and machine access
#
# Everything in this block is off or empty by default. The host this is built for is a 1 GB
# VPS with a fraction of a core, such as an Oracle Always Free micro -- so nothing here costs
# anything until it is switched on, and each thing that is on has a ceiling.
# ---------------------------------------------------------------------------------------------
#
# One JSON object per log line instead of the human format, with the request id that also comes
# back in the x-request-id header. Turn it on when a log shipper is reading the journal, and
# leave it off when you are. The DNS path logs nothing per query either way.
# HYDRA_LOG_JSON=false
#
# Labels /metrics and every alert payload. Defaults to the hostname. Worth setting explicitly
# if you ever run a second instance, because these are per-process figures and two instances
# have two of everything -- two budgets, two rate limiters, two caches.
# HYDRA_INSTANCE_ID=
#
# Prometheus exposition at /metrics. A session or a machine token is required to read it; it is
# not public. The two caps below are what keep a scrape from being expensive: the device series
# is limited to the busiest N devices (there is no per-domain series at all, since domains are
# unbounded), and a rendered scrape is reused for the cache window, so scraping every 15s costs
# one render per 30s and microseconds for the rest.
# HYDRA_METRICS_ENDPOINT=true
# HYDRA_METRICS_CACHE=30
# HYDRA_METRICS_TOP_DEVICES=20

# Names a device has never asked for before are collected on their own tab. Per device, because
# "new" only means anything against what that device already asked. Names this host invented --
# a local zone, a rewrite, a device rule -- are left out, and every device is watched quietly for
# the warm-up before anything counts, so starting the resolver does not report the whole
# internet. Bounded at both ends: this many names per device, and HYDRA_METRICS_TOP_DEVICES
# devices, least recently used evicted first.
# HYDRA_FIRST_SEEN=true
# HYDRA_FIRST_SEEN_MAX=2000
# HYDRA_FIRST_SEEN_WARMUP=3600

#
# Mirror the audit trail to Postgres. Off keeps the last 250 changes in memory -- around 120 KB,
# and gone on a restart, which is fine for "what did I just do" and useless for "what happened
# last Tuesday". Needs 005_audit_log.sql applied.
# HYDRA_AUDIT_PERSIST=false
# HYDRA_AUDIT_FLUSH=120
# HYDRA_AUDIT_RETENTION_DAYS=365
#
# Where attention reasons are POSTed as JSON, so you are told rather than having to look. The
# repeat interval is what makes it usable: a reason is sent when it opens, again when it
# resolves, and in between only after it has stood this long. A certificate expiring in ten days
# should not send a message every ten minutes for ten days.
# HYDRA_ALERT_WEBHOOK=
#
# Web Push to the dashboard PWA. This is the in-house path: the resolver signs each message
# with its own VAPID key and encrypts the payload to the subscribing device, so the push
# service that carries it sees ciphertext and nothing else -- there is no alerting account
# anywhere. Generate a pair once with:
#
#   .venv/bin/python -c 'from hydra_dns import webpush; print(*webpush.generate_keys(), sep=chr(10))'
#
# Rotating the private key invalidates every existing subscription, so devices must re-enable.
# Needs 011_push_subscriptions.sql applied.
# HYDRA_VAPID_PUBLIC_KEY=
# HYDRA_VAPID_PRIVATE_KEY=
# HYDRA_VAPID_SUBJECT=mailto:you@example.com
# HYDRA_ALERT_EVERY=600

# A weekly summary pushed to whoever subscribed: queries, block rate, cache rate, the busiest
# device and what is left of the pooled allowance. Off by default, and it needs the VAPID pair
# above as well as this switch. It counts from the moment it last spoke, so a restart shortens
# the window rather than losing it. The day and hour are read against HYDRA_TIMEZONE.
# HYDRA_DIGEST=true
# HYDRA_DIGEST_DAY=Mon
# HYDRA_DIGEST_HOUR=9
# How many devices the per-device report covers, busiest first, 1-50. The push carries only a
# summary and a link; the report is on the dashboard.
# HYDRA_DIGEST_DEVICES=10

# HYDRA_ALERT_REPEAT=21600
# HYDRA_ALERT_TIMEOUT=8
#
# Query log retention and export. Retention is two-sided: the existing row cap in the flush
# function, plus this age limit. The export caps exist because a 1 GB host that assembled a
# large CSV in memory before sending it would be the thing that killed the resolver -- it is
# streamed in pages instead, yielding between them, one export at a time.
# HYDRA_QUERY_RETENTION_DAYS=30
# HYDRA_EXPORT_MAX_ROWS=20000
# HYDRA_EXPORT_PAGE_ROWS=250
# HYDRA_HEAVY_CONCURRENCY=1
#
# Ceiling on one bulk device change or CSV import. A bulk change writes under a single lock and
# syncs the registry once at the end rather than once per device, but it is still N round trips
# to Postgres, so it is worth a limit.
# HYDRA_BULK_MAX_DEVICES=50
#
# How many policy versions are kept so a change can be rolled back. Needs 008_policy_versions.sql.
# HYDRA_POLICY_VERSIONS_KEPT=50

# HYDRA_APP_DIR=
# HYDRA_APP_CATALOG_URL=https://adguardteam.github.io/HostlistsRegistry/assets/services.json
# HYDRA_APP_CATALOG_REFRESH=86400
# HYDRA_BLOCKLIST_DIR=
# HYDRA_BLOCKLIST_REFRESH=86400
# HYDRA_BLOCKLIST_MAX=8
# HYDRA_BLOCKLIST_MAX_NAMES=400000
# HYDRA_BLOCKLIST_MAX_BYTES=20971520
