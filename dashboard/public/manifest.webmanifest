{
  "name": "Hydra DNS",
  "short_name": "Hydra",
  "description": "One dashboard over several pooled AdGuard DNS accounts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0e10",
  "theme_color": "#0e0e10",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Devices",
      "short_name": "Devices",
      "description": "Device addresses and setup",
      "url": "/#devices",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Query log",
      "short_name": "Log",
      "description": "What the network just asked for",
      "url": "/#log",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
