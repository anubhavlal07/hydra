[Unit]
Description=Hydra DNS -- pooled AdGuard resolver (DoH + DoT)
Documentation=https://github.com/anubhavlal07/hydra
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hydra
Group=hydra
WorkingDirectory=/opt/hydra-dns

Environment=HYDRA_HTTP_PORT=443
Environment=HYDRA_BLOCKLIST_DIR=/var/lib/hydra-dns/blocklists
Environment=HYDRA_APP_DIR=/var/lib/hydra-dns/apps
Environment=HYDRA_PRESENCE_FILE=/var/lib/hydra-dns/presence.json
Environment=PYTHONPATH=/opt/hydra-dns/src
EnvironmentFile=/etc/hydra-dns/hydra.env

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart=/opt/hydra-dns/.venv/bin/python -m hydra_dns.serve
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=3

CPUWeight=800
IOWeight=800
MemoryHigh=420M
MemoryMax=512M
OOMScoreAdjust=-500
TasksMax=64
LimitNOFILE=8192

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/etc/letsencrypt
StateDirectory=hydra-dns
StateDirectoryMode=0700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydra-dns

[Install]
WantedBy=multi-user.target
